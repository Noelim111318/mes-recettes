rules_version = '2';

// Mes Recettes — chaque recette appartient a une seule utilisatrice
// (ownerId), qui est la seule a pouvoir la lire/modifier/supprimer.
// `sharedWith` est reserve a une future fonctionnalite de partage : force
// vide a la creation, jamais lu ici pour l'instant (pas de migration a
// prevoir le jour ou on l'active : il suffira d'elargir `allow read` a
// `resource.data.sharedWith.hasAny([request.auth.uid])`).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(data) {
      return request.auth != null && request.auth.uid == data.ownerId;
    }
    // UID fige du compte administrateur (lecture seule sur toutes les
    // recettes) : un seul compte pour cette app perso, pas besoin d'une
    // liste/role dynamique.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'EwBMsqx4MGXHNHcPlkpb7StazJp2';
    }

    match /recipes/{recipeId} {
      // Lecture seule pour l'admin : ni creation, ni modification, ni
      // suppression des recettes d'une autre utilisatrice.
      allow read: if isOwner(resource.data) || isAdmin();

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.sharedWith is list
        && request.resource.data.sharedWith.size() == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;

      allow update: if isOwner(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isOwner(resource.data);
    }
  }
}
