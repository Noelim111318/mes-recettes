rules_version = '2';

// Mes Recettes — chaque recette appartient a une seule utilisatrice
// (ownerId), qui est la seule a pouvoir la creer/modifier/supprimer... sauf
// deux exceptions en libre-service pour une personne a qui la recette est
// partagee : marquer/demarquer SA propre entree dans `favoritedBy`, et se
// retirer elle-meme de `sharedWith` (= masquer la recette de sa vue). Ces
// deux cas sont verifies champ par champ (voir onlyChangedKey + addedSelfTo/
// removedSelfFrom) : impossible de toucher a autre chose, y compris a
// l'entree d'une autre personne dans ces memes listes.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(data) {
      return request.auth != null && request.auth.uid == data.ownerId;
    }
    function isSharedWithMe(data) {
      return request.auth != null && ('sharedWith' in data) && data.sharedWith.hasAny([request.auth.uid]);
    }
    // UID fige du compte administrateur (lecture seule sur toutes les
    // recettes) : un seul compte pour cette app perso, pas besoin d'une
    // liste/role dynamique.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'EwBMsqx4MGXHNHcPlkpb7StazJp2';
    }

    // Compte "debloque" par l'admin : existence de quotas/{uid} (ecrit par
    // l'admin seul). Les autres comptes sont limites (voir plus bas) pour
    // eviter les abus : 2 recettes et 3 photos par recette.
    function isApproved() {
      return isAdmin()
        || (request.auth != null && exists(/databases/$(database)/documents/quotas/$(request.auth.uid)));
    }
    // E-mail confirme (jeton Firebase Auth ; les comptes Google le sont d'office).
    function isVerified() {
      return request.auth.token.email_verified == true;
    }
    // Pas de compteur possible dans les regles : les 2 recettes d'un compte
    // limite sont deux "emplacements" a l'id impose ({uid}_1, {uid}_2). Un id
    // ne peut exister qu'une fois, donc pas plus de 2 creations simultanees ;
    // supprimer une recette libere son emplacement.
    function isFreeSlot(recipeId) {
      return recipeId == request.auth.uid + '_1' || recipeId == request.auth.uid + '_2';
    }
    // Compte limite : 3 photos max par recette (une recette ayant deja plus de
    // 3 photos avant l'introduction du quota reste modifiable, sans en ajouter).
    function photosOnCreateOk() {
      return request.resource.data.get('photos', []).size() <= 3;
    }
    function photosOnUpdateOk() {
      return request.resource.data.get('photos', []).size() <= 3
        || request.resource.data.get('photos', []).size() <= resource.data.get('photos', []).size();
    }

    function onlyChangedKey(key) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([key]);
    }
    // Avant/apres restreints a un seul ajout ou retrait de mon propre uid
    // dans la liste `field` : empeche de toucher a l'entree d'une autre
    // personne sous couvert de modifier la mienne.
    function addedSelfTo(field) {
      return request.resource.data.get(field, []).size() == resource.data.get(field, []).size() + 1
        && request.resource.data.get(field, []).hasAll(resource.data.get(field, []))
        && (request.auth.uid in request.resource.data.get(field, []))
        && !(request.auth.uid in resource.data.get(field, []));
    }
    function removedSelfFrom(field) {
      return resource.data.get(field, []).size() == request.resource.data.get(field, []).size() + 1
        && resource.data.get(field, []).hasAll(request.resource.data.get(field, []))
        && (request.auth.uid in resource.data.get(field, []))
        && !(request.auth.uid in request.resource.data.get(field, []));
    }
    function canToggleOwnFavorite() {
      return onlyChangedKey('favoritedBy') && (addedSelfTo('favoritedBy') || removedSelfFrom('favoritedBy'));
    }
    function canLeaveShared() {
      return onlyChangedKey('sharedWith') && removedSelfFrom('sharedWith');
    }

    match /recipes/{recipeId} {
      // Lecture seule pour l'admin et les comptes avec qui la recette est
      // partagee : ni creation, ni modification (hors les deux exceptions
      // en libre-service ci-dessus), ni suppression d'une recette dont on
      // n'est pas proprietaire.
      allow read: if isOwner(resource.data) || isAdmin() || isSharedWithMe(resource.data);

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.sharedWith is list
        && request.resource.data.sharedWith.size() == 0
        && request.resource.data.favoritedBy is list
        && request.resource.data.favoritedBy.size() == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && (isApproved() || (isVerified() && isFreeSlot(recipeId) && photosOnCreateOk()));

      allow update: if (isOwner(resource.data) && request.resource.data.ownerId == resource.data.ownerId
          && (isApproved() || photosOnUpdateOk()))
        || (isSharedWithMe(resource.data) && (canToggleOwnFavorite() || canLeaveShared()));

      allow delete: if isOwner(resource.data);
    }

    // Annuaire minimal uid -> e-mail, alimente au login (voir
    // upsertUserProfile dans recipes.js) : sert a retrouver l'uid d'une
    // personne a qui partager une recette a partir de son e-mail. Chacune
    // n'ecrit que sa propre fiche ; la lecture est ouverte a toute
    // utilisatrice connectee (necessaire pour la recherche par e-mail, et
    // sans donnee sensible au-dela de l'e-mail deja visible dans l'app).
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Deblocage de compte : quotas/{uid} existe = compte debloque. Ecriture
    // reservee a l'admin (surtout pas dans users/{uid}, que chacune peut
    // modifier) ; la personne concernee peut seulement le lire.
    match /quotas/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Demande de deblocage (une seule par compte, remplacable) : e-mail +
    // motivation. L'admin la lit, puis debloque ou refuse (status: 'refused').
    match /unlockRequests/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid && isVerified()
          && request.resource.data.keys().hasOnly(['email', 'message', 'createdAt'])
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 500);
      allow delete: if isAdmin();
    }
  }
}
